{
    "name": "rekalogika/rekapager-doctrine-collections-adapter",
    "description": "Doctrine Collections adapter for Rekapager pagination library",
    "homepage": "https://rekalogika.dev/rekapager",
    "keywords": [
        "pagination",
        "rekapager",
        "pager",
        "keyset-pagination",
        "offset-pagination",
        "doctrine",
        "collections",
        "doctrine-collections",
        "selectable"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Priyadi Iman Nurcahyo",
            "email": "priyadi@rekalogika.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Rekalogika\\Rekapager\\Doctrine\\Collections\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "doctrine/collections": "^3.1",
        "symfony/polyfill-php86": "^1.37",
        "rekalogika/rekapager-adapter-common": "^1.3",
        "rekalogika/rekapager-contracts": "^1.3",
        "rekalogika/rekapager-keyset-pagination": "^1.3",
        "rekalogika/rekapager-offset-pagination": "^1.3"
    }
}
